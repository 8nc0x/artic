PORT=5000

# 1. PostgreSQL Database on VPS (Required for persistent relational storage)
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql://polar_user:polar_secure_pass@localhost:5432/polar_db

# 2. Google Gemini API Key (Optional)
# Enables live generative AI answering and multi-channel outreach draft synthesis
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. JWT Authentication Secret (Optional)
# Secret key used for signing researcher/admin session tokens
JWT_SECRET=ncpor-secret-key-polar-science-portal-2026

# 4. Cloudinary Image & Document Storage (Optional)
# Used if you wish to store uploaded research PDFs and expedition media on Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

