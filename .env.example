# ============================================================
# NCPOR POLAR SCIENCE PORTAL — ENVIRONMENT CONFIGURATION
# ============================================================
# Keep all secret credentials backend-only. Never prefix backend secrets with VITE_*.

# Application URLs & Ports
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
COOKIE_SECRET=ncpor_polar_cookie_secret_super_secure_key_2026

# PostgreSQL Primary Database (Supabase / Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncpor_polar_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ncpor_polar_db

# Authentication (JWT Access + Refresh Token Rotation)
JWT_ACCESS_SECRET=ncpor_polar_jwt_access_secret_256bit_token
JWT_REFRESH_SECRET=ncpor_polar_jwt_refresh_rotation_secret_key_512bit

# Redis Cache & Pub/Sub
REDIS_URL=redis://127.0.0.1:6379

# AI & LLM Inference (Text Intelligence)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative smaller task model: llama-3.1-8b-instant

# AI Multimodal & Image Generation (Gemini API)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Cloudinary Media Storage (Dual Pipeline & Signed Client Uploads)
CLOUDINARY_CLOUD_NAME=ncpor-media
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Dispatch (Dual Pipeline: Resend API + SMTP Fallback)
RESEND_API_KEY=
SMTP_HOST=smtp.ncpor.res.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="NCPOR Polar Science Portal <noreply@ncpor.res.in>"

# NCPOR Official Data Sources Registry
NCPOR_DATASET_SOURCE=./PolarConnect-data/PolarConnect-data/ncpor_datasets.json
NCPOR_DATASET_URL=https://npdc.ncpor.res.in/datasets

# Social Media Channels (Official OAuth Bearer Tokens)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=ncpor.goa

FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=NCPOR.India

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
